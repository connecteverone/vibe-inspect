+        .map_err(|error| std::io::Error::new(std::io::ErrorKind::Other, error))?;
+    write_atomic_file(&path, &payload)?;
+    Ok(path)
+}
+
+fn discovery_tmp_path(path: &Path) -> PathBuf {
+    let suffix: String = rand::thread_rng()
+        .sample_iter(&Alphanumeric)
+        .take(12)
+        .map(char::from)
+        .collect();
+    let file_name = path
