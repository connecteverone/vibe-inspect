+                    && label == last_label
+                    && notifications.is_empty()
+                {
+                    if last_sent_at.elapsed() > Duration::from_secs(15) {
+                        let _ = sender.send(Message::Ping(Vec::new().into())).await;
+                        last_sent_at = Instant::now();
