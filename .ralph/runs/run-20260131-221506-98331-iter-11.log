String _stripLeadingHttpMethod(String input) {
  final trimmed = input.trim();
  final match = RegExp(
    r'^(get|post|put|patch|delete|head|options)\b',
    caseSensitive: false,
  ).firstMatch(trimmed);
  if (match == null) {
    return trimmed;
  }
  return trimmed.substring(match.end).trim();
}


