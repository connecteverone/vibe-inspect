+            cols: Some(5),
+            rows: Some(2),
+            since: None,
+            limit: None,
+            notify_since: None,
+            working_dir: None,
+            env: None,
+        }) {
+            Ok(_) => panic!("expected invalid size error"),
+            Err(error) => error,
+        };
+        assert_eq!(error.code, "invalid_size");
+    }
