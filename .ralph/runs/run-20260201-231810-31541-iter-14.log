+            }
+        }
+    }
+
+    impl Drop for ManagedSession {
+        fn drop(&mut self) {
+            if let Ok(mut session) = self.session.lock() {
+                let _ = session.child.kill();
+            }
+            if let Ok(mut manager) = terminal_manager().lock() {
+                manager.remove_session(&self.session_id);
+            }
