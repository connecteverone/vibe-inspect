+        {
+            Ok(payload) => ok_response(
+                &request.request_id,
+                json!({
+                    "type": "vnc",
+                    "status": "accepted",
+                    "action": payload.action,
+                    "session_id": payload.session_id,
+                    "width": payload.width,
+                    "height": payload.height,
+                }),
+            ),
