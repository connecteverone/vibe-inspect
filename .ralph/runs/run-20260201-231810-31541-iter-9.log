+        return IdleCleanupConfig {
+            ttl_secs: 0,
+            warning_lead_secs: 0,
+        };
+    }
+    let mut warning = parse_env_seconds(ENV_IDLE_WARNING_SECS).unwrap_or(DEFAULT_IDLE_WARNING_SECS);
+    if warning >= ttl {
+        warning = ttl.saturating_div(2);
+    }
+    IdleCleanupConfig {
+        ttl_secs: ttl,
+        warning_lead_secs: warning,
+    }
