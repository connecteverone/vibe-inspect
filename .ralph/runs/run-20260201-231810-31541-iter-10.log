+
+fn build_input_payload_from_parts(
+    input: &Option<String>,
+    input_bytes: &Option<Vec<u8>>,
+) -> Result<Option<Value>, TerminalError> {
+    let mut payload = Map::new();
+    match (input, input_bytes) {
+        (Some(input), None) => {
