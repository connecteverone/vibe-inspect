from http.server import BaseHTTPRequestHandler, HTTPServer
import json

state = {\"count\": 0}

class Handler(BaseHTTPRequestHandler):
    def _set_headers(self, status=200, extra=None):
        self.send_response(status)
        self.send_header(\"Content-Type\", \"application/json\")
        self.send_header(\"Access-Control-Allow-Origin\", \"*\")
        self.send_header(\"Access-Control-Allow-Methods\", \"POST, OPTIONS\")
        self.send_header(\"Access-Control-Allow-Headers\", \"Content-Type\")
        if extra:
            for key, value in extra.items():
                self.send_header(key, value)
        self.end_headers()

    def do_OPTIONS(self):
        self._set_headers(204)

    def do_POST(self):
        if self.path "'!= "/command":
            self._set_headers(404)
            self.wfile.write(json.dumps({"status": "error"}).encode("utf-8"))
            return
        length = int(self.headers.get("Content-Length", 0))
        data = self.rfile.read(length)
        try:
            request_json = json.loads(data.decode("utf-8"))
        except Exception:
            self._set_headers(400)
            self.wfile.write(json.dumps({
                "status": "error",
                "error": {"message": "invalid_json"}
            }).encode("utf-8"))
            return
        state["count"] += 1
        body = {"result": "ok", "value": state["count"]}
        if state["count"] > 1:
            body["extra"] = True
        response_payload = {
            "request_id": request_json.get("request_id", ""),
            "status": "ok",
            "payload": {
                "request": request_json.get("payload", {}),
                "response": {
                    "status": 200,
                    "latency_ms": 123,
                    "headers": {"content-type": "application/json"},
                    "body": body,
                },
            },
        }
        self._set_headers()
        self.wfile.write(json.dumps(response_payload).encode("utf-8"))

    def log_message(self, format, *args):
        return

if __name__ == "__main__":
    server = HTTPServer(("127.0.0.1", 8031), Handler)
    server.serve_forever()
