+  static Future<void> _createSchema(Database db) async {
+    await db.execute('''
+      CREATE TABLE tool_sessions (
+        id TEXT PRIMARY KEY,
+        type TEXT NOT NULL,
+        label TEXT NOT NULL,
+        status TEXT NOT NULL,
+        created_at INTEGER NOT NULL
+      )
