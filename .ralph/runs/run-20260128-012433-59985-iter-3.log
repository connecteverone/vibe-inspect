+          return StorageErrorScreen(
+            error: snapshot.error,
+            onRetry: _retryInitialization,
+          );
+        }
+        final storage = snapshot.data;
+        if (storage == null) {
+          return const StorageErrorScreen(
+            error: 'Storage failed to load.',
