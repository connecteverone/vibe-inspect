bool _containsKeyword(String input, List<String> keywords) {
  for (final keyword in keywords) {
    final expression = RegExp(
      '\\b${RegExp.escape(keyword)}\\b',
      caseSensitive: false,
    );
    if (expression.hasMatch(input)) {
      return true;
    }
  }
  return false;
}

