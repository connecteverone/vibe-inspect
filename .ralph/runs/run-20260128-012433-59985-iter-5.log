+enum CommandTool { api, terminal, ai, vnc }
+
+extension CommandToolMetadata on CommandTool {
+  String get label {
+    switch (this) {
+      case CommandTool.api:
+        return 'API Explorer';
+      case CommandTool.terminal:
+        return 'Terminal';
+      case CommandTool.ai:
+        return 'AI Insight';
+      case CommandTool.vnc:
+        return 'VNC Viewer';
+    }
+  }
+
+  String get storageKey {
+    switch (this) {
+      case CommandTool.api:
+        return 'api';
+      case CommandTool.terminal:
+        return 'terminal';
+      case CommandTool.ai:
+        return 'ai';
+      case CommandTool.vnc:
+        return 'vnc';
+    }
+  }
+}
