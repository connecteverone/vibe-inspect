+    final parsed = _uniqueIntents(_parseCommandIntents(command));
+    if (parsed.length == 1) {
+      return parsed.first;
+    }
+
+    final options = parsed.isEmpty ? _buildFallbackIntents(command) : parsed;
+    options.sort((a, b) => a.tool.index.compareTo(b.tool.index));
