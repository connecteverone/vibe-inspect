+        return;
+      case CommandTool.vnc:
+        _pushContextScreen(
+          VncSessionScreen(
+            event: event,
+            session: session,
+          ),
+        );
+        return;
+    }
+  }
+
+  Future<ToolSession?> _resolveSession(String sessionId) async {
