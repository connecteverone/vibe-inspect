+      _commandController.selection =
+          TextSelection.collapsed(offset: example.length);
+      _commandError = null;
+      _commandFeedback = null;
+    });
+  }
+
+  void _clearCommandInput() {
+    setState(() {
+      _commandController.clear();
+      _commandError = null;
+      _commandFeedback = null;
+    });
+  }
