+      setState(() {
+        _commandError = 'Enter a command to run.';
+      });
+      return;
+    }
+
+    setState(() {
+      _commandError = null;
+      _commandFeedback = null;
+    });
+
+    final intent = await _resolveCommandIntent(command);
+    if (!mounted || intent == null) {
+      return;
+    }
+
+    await _routeCommandIntent(intent);
+  }
