+        Some(session_id.to_string()),
+        payload,
+    );
+    sender
+        .send(TungsteniteMessage::Text(request.to_string()))
+        .await
+        .map_err(|error| CliError::new("connection_failed", format!("Failed to send {action}: {error}")))?;
+    Ok(())
+}
