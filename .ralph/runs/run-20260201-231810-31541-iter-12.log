+fn spawn_stdin_reader(sender: mpsc::Sender<Vec<u8>>) -> thread::JoinHandle<()> {
+    thread::spawn(move || {
+        let mut stdin = std::io::stdin();
+        let mut buffer = [0u8; 1024];
+        loop {
+            match stdin.read(&mut buffer) {
+                Ok(0) => break,
+                Ok(count) => {
+                    if sender
+                        .blocking_send(buffer[..count].to_vec())
+                        .is_err()
+                    {
+                        break;
+                    }
+                }
+                Err(_) => break,
+            }
+        }
+    })
+}
