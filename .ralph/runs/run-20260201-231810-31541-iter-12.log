+    let payload = match std::str::from_utf8(bytes) {
+        Ok(text) => json!({ "data": text }),
+        Err(_) => {
+            let encoded = base64::engine::general_purpose::STANDARD.encode(bytes);
+            json!({ "data_b64": encoded })
