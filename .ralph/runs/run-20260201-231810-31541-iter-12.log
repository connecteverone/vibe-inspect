+        if byte == detach_sequence.prefix {
+            *prefix_deadline = Some(Instant::now() + detach_sequence.timeout);
+        } else if !read_only {
+            buffer.push(byte);
+        }
+    }
+    if !read_only && !buffer.is_empty() {
