+
+impl RawModeGuard {
+    fn new(enable: bool) -> Result<Self, CliError> {
+        if enable {
+            enable_raw_mode().map_err(|error| {
+                CliError::new("terminal_error", format!("Failed to enable raw mode: {error}"))
+            })?;
+        }
+        Ok(Self { enabled: enable })
+    }
