+        match message {
+            Ok(TungsteniteMessage::Text(text)) => {
+                if let Some(result) = parse_terminald_response(&text, attach_id) {
+                    return result.map(|_| ());
+                }
+                if let Some(payload) = extract_terminal_payload_event(&text, session_id) {
