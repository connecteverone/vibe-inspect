+        tokio::spawn(async move {
+            let mut signals = match signal(SignalKind::window_change()) {
+                Ok(value) => value,
+                Err(_) => return,
+            };
+            loop {
+                if signals.recv().await.is_none() {
+                    break;
+                }
+                if let Ok((cols, rows)) = terminal::size() {
+                    if sender.send((cols, rows)).await.is_err() {
+                        break;
+                    }
+                }
+            }
+        });
+    }
+    #[cfg(not(unix))]
+    {
+        let _ = sender;
+    }
+}
