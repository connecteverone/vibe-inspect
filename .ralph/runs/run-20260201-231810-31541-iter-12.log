+                        eprintln!("{}: {}", error.code, error.message);
+                    }
+                }
+            }
+            Ok(TungsteniteMessage::Ping(payload)) => {
+                let _ = sender.send(TungsteniteMessage::Pong(payload)).await;
+            }
+            Ok(TungsteniteMessage::Close(_)) => {
+                return Err(CliError::new(
+                    "connection_failed",
