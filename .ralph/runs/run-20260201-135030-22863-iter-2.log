import { connect } from \"@/client.js\";

const client = await connect();
const page = await client.page(\"vibe-inspect\");
page.setDefaultTimeout(5000);
await page.route('**/command', async (route) => {
  const request = route.request();
  let body = {};
  const postData = request.postData();
  if (postData) {
    try {
      body = JSON.parse(postData);
    } catch (_) {
      body = {};
    }
  }
  let payload = {};
  if (body.command === 'identity') {
    payload = { device_id: 'mock-device', host_name: 'mock-host' };
  } else if (body.command === 'vnc') {
    payload = {
      session_id: body.payload?.session_id || 'mock-session',
      width: 1280,
      height: 720,
      input_width: 1280,
      input_height: 720,
      input_origin_x: 0,
      input_origin_y: 0,
      input_scale_x: 1,
      input_scale_y: 1,
      screen_width: 1280,
      screen_height: 720,
      ws_path: '/vnc/mock',
    };
  }
  const responseBody = JSON.stringify({ status: 'ok', request_id: body.request_id || 'mock', payload });
  await route.fulfill({ status: 200, contentType: 'application/json', body: responseBody });
});

await page.evaluate(() => {
  const setValue = (label, value) => {
    const input = document.querySelector("'`input[aria-label="${label}"]`);
    if (!input) return;
    input.value = value;
    input.dispatchEvent(new Event('"'input', { bubbles: true }));
    input.dispatchEvent(new Event('change', { bubbles: true }));
  };
  setValue('Agent URL', 'http://127.0.0.1:9090');
  setValue('Fixed token', 'mock-token');
});
await page.getByRole('button', { name: 'Connect' }).click();
await page.waitForTimeout(2000);
const snapshot = await client.getAISnapshot('vibe-inspect');
console.log(snapshot);
await page.screenshot({ path: 'tmp/vibe-inspect-after-connect.png', fullPage: true });
await client.disconnect();
