thinking
**Mapping VNC session screen flow**

VncSessionScreen shows its UI even if the VNC WebSocket connection fails by stubbing the agent's /command endpoint with session info; this means we can display the screen and fullscreen controls without an actual VNC backend by creating a mock agent server that passes pairing.
thinking
**Creating Python mock agent server**

I'm preparing a simple Python HTTP server script to respond with static JSON on `/command` for identity and VNC commands, running it in the background on port 9090 to serve as a mock agent backend outside the repo.
exec
/bin/zsh -lc "cat <<'PY' > /tmp/mock_agent.py
import json
from http.server import BaseHTTPRequestHandler, HTTPServer

class Handler(BaseHTTPRequestHandler):
    def do_POST(self):
        length = int(self.headers.get('Content-Length', 0))
        body = self.rfile.read(length) if length else b\"{}\"
        try:
            data = json.loads(body)
        except Exception:
            data = {}
        cmd = data.get(\"command\")
        payload = {}
        if cmd == \"identity\":
            payload = {
                \"device_id\": \"mock-device\",
                \"host_name\": \"mock-host\",
            }
        elif cmd == \"vnc\":
            payload = {
                \"session_id\": data.get(\"payload\", {}).get(\"session_id\") or \"mock-session\",
                \"width\": 1280,
                \"height\": 720,
                \"input_width\": 1280,
                \"input_height\": 720,
                \"input_origin_x\": 0,
                \"input_origin_y\": 0,
                \"input_scale_x\": 1,
                \"input_scale_y\": 1,
                \"screen_width\": 1280,
                \"screen_height\": 720,
                \"ws_path\": \"/vnc/mock\",
            }
        response = {
            \"status\": \"ok\",
            \"request_id\": data.get(\"request_id\", \"mock\"),
            \"payload\": payload,
        }
        out = json.dumps(response).encode(\"utf-8\")
        self.send_response(200)
        self.send_header(\"Content-Type\", \"application/json\")
        self.send_header(\"Content-Length\", str(len(out)))
        self.end_headers()
        self.wfile.write(out)

    def log_message(self, format, *args):
        return


if __name__ == \"__main__\":
    HTTPServer((\"127.0.0.1\", 9090), Handler).serve_forever()
