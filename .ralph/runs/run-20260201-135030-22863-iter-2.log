import shutil
paths = [
    '.codex/skills/dev-browser/node_modules',
    '.codex/skills/dev-browser/profiles',
    '.codex/skills/dev-browser/tmp',
]
for path in paths:
    shutil.rmtree(path, ignore_errors=True)
