+    final updatedSession = _sessionWithStatus(view.session, 'complete');
+    await _persistSession(updatedSession);
+    if (!mounted) {
+      return;
+    }
+    _replaceSession(sessionId, view.copyWith(session: updatedSession));
+    await _persistTerminalEvent(
