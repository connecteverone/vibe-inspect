+  List<String> _coerceOutputList(dynamic raw) {
+    if (raw == null) {
+      return [];
+    }
+    if (raw is List) {
+      return raw
+          .map((entry) => entry?.toString() ?? '')
+          .where((line) => line.trim().isNotEmpty)
+          .toList();
+    }
+    if (raw is String) {
+      return raw
+          .split('\n')
+          .map((line) => line.trim())
+          .where((line) => line.isNotEmpty)
+          .toList();
+    }
+    return [raw.toString()];
+  }
