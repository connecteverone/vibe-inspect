+    if (command.isEmpty) {
+      _commandController.clear();
+      return;
+    }
+    _commandController.text = command;
+    _commandController.selection = TextSelection.collapsed(
+      offset: command.length,
+    );
+  }
+
+  void _autoRunInitialCommand() {
+    if (_autoRunTriggered) {
+      return;
