+  Future<void> _persistSession(ToolSession session) async {
+    try {
+      await widget.storage.insertToolSession(session);
+    } catch (error) {
+      if (!mounted) {
+        return;
+      }
+      ScaffoldMessenger.of(context).showSnackBar(
+        SnackBar(
+          content: Text(
+            'Failed to save terminal session: ${error.toString()}',
