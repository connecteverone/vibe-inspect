+  void _configureAgentClient() {
+    final baseUrl = widget.agentBaseUrl?.trim();
+    if (baseUrl == null || baseUrl.isEmpty) {
+      _agentClient = null;
+      _httpClient?.close();
+      _httpClient = null;
+      return;
