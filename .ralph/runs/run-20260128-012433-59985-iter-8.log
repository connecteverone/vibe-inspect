+          output: output,
+          lastCommand: lastCommand,
+          lastEvent: event,
+        );
+      }).toList();
+      if (!mounted) {
+        return;
+      }
+      setState(() {
+        _sessions = views;
+        _activeSessionId = initialSession?.id ??
+            (views.isNotEmpty ? views.first.session.id : null);
+        _isLoading = false;
+      });
+      _seedCommandFromActive();
+      _autoRunInitialCommand();
+    } catch (_) {
+      if (!mounted) {
