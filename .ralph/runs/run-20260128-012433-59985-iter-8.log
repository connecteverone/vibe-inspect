String _truncate(String input, int maxLength) {
  final trimmed = input.trim();
  if (trimmed.length <= maxLength) {
    return trimmed;
  }
  if (maxLength <= 3) {
    return trimmed.substring(0, maxLength);
  }
  return '${trimmed.substring(0, maxLength - 3)}...';
}

