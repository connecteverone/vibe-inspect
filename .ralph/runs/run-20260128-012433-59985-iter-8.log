+      _seedCommandFromActive();
+      _autoRunInitialCommand();
+    } catch (_) {
+      if (!mounted) {
+        return;
+      }
+      setState(() {
+        _isLoading = false;
+        _loadError = 'Unable to load terminal sessions.';
+      });
