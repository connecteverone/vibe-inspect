+    final status = event.payload['status']?.toString().toLowerCase() ?? '';
+    if (status.isNotEmpty && status != 'queued') {
+      return;
+    }
+    final command = event.payload['command']?.toString().trim();
+    if (command == null || command.isEmpty) {
