+    payload['command'] = command;
+    payload['status'] = status;
+    payload['stdout'] = entries
+        .where((entry) => entry.stream == TerminalStream.stdout)
+        .map((entry) => entry.text)
+        .toList();
+    payload['stderr'] = entries
