+
+    add(TerminalStream.stdout, r'$ ' + command);
+    if (lower.contains('npm test')) {
+      add(TerminalStream.stdout, '> vibe-inspect@1.0.0 test');
+      add(TerminalStream.stdout, '> vitest run');
