+      add(TerminalStream.stdout, '> vibe-inspect@1.0.0 test');
+      add(TerminalStream.stdout, '> vitest run');
+      add(TerminalStream.stdout, ' RUN  v1.2.0 /workspace');
+      add(TerminalStream.stdout, ' ✓ src/app.spec.ts (3 tests)');
+      add(
