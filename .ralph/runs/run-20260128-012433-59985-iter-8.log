/bin/zsh -lc "npx tsx <<'EOF'
import { connect } from \"@/client.js\";

const client = await connect();
const page = await client.page(\"vibe-terminal\");
await page.goto(\"http://127.0.0.1:8030\");
await page.waitForTimeout(2000);

const inputs = page.locator('input');
const commandInput = inputs.nth(1);
await commandInput.evaluate((el) => el.focus());
await page.keyboard.type('run npm test');

const runButton = page.getByRole('button', { name: 'Run command' });
await runButton.scrollIntoViewIfNeeded();
await runButton.click();

await page.waitForTimeout(1500);

const url = page.url();
const hasTerminal = await page.evaluate(() => {
  return Array.from(document.querySelectorAll('h1,h2')).some((el) => el.textContent?.includes('Terminal'));
});
