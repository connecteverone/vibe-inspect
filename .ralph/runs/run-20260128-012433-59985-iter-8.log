+    case 'disconnected':
+      return const _TerminalStatusStyle(
+        Color(0xFFFEE2E2),
+        Color(0xFFB91C1C),
+      );
+    case 'closed':
+      return const _TerminalStatusStyle(
+        Color(0xFFE2E8F0),
+        Color(0xFF475569),
+      );
+    default:
+      return const _TerminalStatusStyle(
+        Color(0xFFFEF3C7),
+        Color(0xFF92400E),
+      );
