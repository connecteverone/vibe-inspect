+          stream: TerminalStream.stdout,
+          text: line,
+          timestamp: createdAt,
+        ),
+      );
+    }
+    for (final line in stderrLines) {
+      entries.add(
+        TerminalOutputEntry(
+          stream: TerminalStream.stderr,
+          text: line,
+          timestamp: createdAt,
+        ),
+      );
+    }
+    if (entries.isEmpty) {
+      final preview = payload['output_preview'] ?? payload['output'];
+      final previewText = preview?.toString().trim() ?? '';
+      if (previewText.isNotEmpty) {
+        entries.add(
+          TerminalOutputEntry(
+            stream: TerminalStream.stdout,
+            text: previewText,
+            timestamp: createdAt,
+          ),
+        );
+      }
+    }
+    return entries;
+  }
+
+  List<String> _coerceOutputList(dynamic raw) {
+    if (raw == null) {
+      return [];
+    }
+    if (raw is List) {
+      return raw
+          .map((entry) => entry?.toString() ?? '')
+          .where((line) => line.trim().isNotEmpty)
+          .toList();
+    }
+    if (raw is String) {
+      return raw
+          .split('\n')
+          .map((line) => line.trim())
+          .where((line) => line.isNotEmpty)
+          .toList();
+    }
+    return [raw.toString()];
+  }
+
+  String _buildOutputPreview(List<TerminalOutputEntry> entries) {
+    if (entries.isEmpty) {
+      return '';
+    }
+    final preview = entries.take(3).map((entry) => entry.text).toList();
+    return preview.join('\n');
+  }
