+      entries.add(
+        TerminalOutputEntry(
+          stream: TerminalStream.stdout,
+          text: line,
+          timestamp: createdAt,
+        ),
+      );
+    }
+    for (final line in stderrLines) {
+      entries.add(
+        TerminalOutputEntry(
+          stream: TerminalStream.stderr,
+          text: line,
+          timestamp: createdAt,
+        ),
