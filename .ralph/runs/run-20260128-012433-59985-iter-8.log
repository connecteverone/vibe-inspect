+      if (mounted) {
+        setState(() {
+          _isSending = false;
+        });
+      }
+      return;
+    } catch (error) {
+      await _markSessionDisconnected(
+        active.session.id,
+        'Terminal command failed: ${error.toString()}',
+      );
+      if (mounted) {
+        setState(() {
+          _isSending = false;
+        });
+      }
+      return;
+    }
