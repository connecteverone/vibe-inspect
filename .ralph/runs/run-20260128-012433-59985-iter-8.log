+    payload['updated_at'] = DateTime.now().toIso8601String();
+    final updatedEvent = TimelineEvent(
+      id: event.id,
+      sessionId: event.sessionId,
+      type: event.type,
+      title: event.title,
+      payload: payload,
+      createdAt: event.createdAt,
+    );
+    try {
+      await widget.storage.insertTimelineEvent(updatedEvent);
+    } catch (error) {
