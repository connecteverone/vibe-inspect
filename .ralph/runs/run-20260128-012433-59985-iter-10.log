+    if (tunnelUrl != null && tunnelUrl is! String) {
+      throw const FormatException('Connection tunnelUrl must be a string.');
+    }
+    final tunnelError = json['tunnelError'];
+    if (tunnelError != null && tunnelError is! String) {
