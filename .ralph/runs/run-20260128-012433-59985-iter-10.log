+  Future<void> _importBundle(String raw) async {
+    setState(() {
+      _importStatus = null;
+      _importStatusIsError = false;
+    });
+    ExportBundle bundle;
+    try {
+      final decoded = jsonDecode(raw);
+      if (decoded is! Map) {
