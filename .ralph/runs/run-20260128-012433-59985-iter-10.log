+      ),
+      tunnelUrl: row['tunnel_url']?.toString(),
+      tunnelError: row['tunnel_error']?.toString(),
+      lastSeenAt: row['last_seen_at'] != null
+          ? DateTime.fromMillisecondsSinceEpoch(
+              (row['last_seen_at'] as int?) ?? 0,
+            )
