+
+      .payload {
+        font-family: "SFMono-Regular", "Menlo", monospace;
+        font-size: 0.82rem;
+        color: var(--slate);
+        background: var(--cream);
+        padding: 12px;
+        border-radius: 12px;
+        border: 1px dashed var(--stone);
+        word-break: break-all;
+      }
+
+      .status {
+        padding: 12px 16px;
+        border-radius: 14px;
+        background: var(--mint);
+        color: #0f5132;
+        font-weight: 600;
