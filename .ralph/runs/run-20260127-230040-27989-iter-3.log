+      .label {
+        font-size: 0.78rem;
+        text-transform: uppercase;
+        letter-spacing: 0.08em;
+        color: var(--slate);
+      }
+
+      .value {
+        font-size: 1.2rem;
+        font-weight: 600;
+      }
+
+      .payload {
+        font-family: "SFMono-Regular", "Menlo", monospace;
+        font-size: 0.82rem;
+        color: var(--slate);
+        background: var(--cream);
+        padding: 12px;
+        border-radius: 12px;
+        border: 1px dashed var(--stone);
+        word-break: break-all;
+      }
+
+      .status {
+        padding: 12px 16px;
+        border-radius: 14px;
+        background: var(--mint);
+        color: #0f5132;
+        font-weight: 600;
+      }
+
+      .status.error {
+        background: #fee2e2;
+        color: #7f1d1d;
+      }
+
+      @media (max-width: 720px) {
