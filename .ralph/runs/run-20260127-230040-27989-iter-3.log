     <meta charset="UTF-8" />
     <meta name="viewport" content="width=device-width, initial-scale=1.0" />
     <title>Vibe Inspect Agent</title>
+    <style>
+      :root {
+        color-scheme: light;
+        --ink: #0f172a;
+        --slate: #334155;
+        --stone: #e2e8f0;
+        --cream: #f8fafc;
+        --accent: #e07a5f;
+        --accent-dark: #be5a3c;
+        --mint: #d7f2e3;
+      }
+
+      * {
+        box-sizing: border-box;
+      }
+
+      body {
+        margin: 0;
+        min-height: 100vh;
+        font-family: "Avenir Next", "Futura", "Trebuchet MS", sans-serif;
+        color: var(--ink);
