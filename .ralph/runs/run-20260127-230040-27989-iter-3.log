+        flex-direction: column;
+        align-items: center;
+        gap: 16px;
+        padding: 16px;
+        background: white;
+        border-radius: 18px;
+        border: 1px solid var(--stone);
+      }
+
+      .qr-card svg {
+        width: 220px;
+        height: 220px;
