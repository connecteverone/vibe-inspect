+class _HeadersBlock extends StatelessWidget {
+  const _HeadersBlock({required this.headers});
+
+  final Map<String, String> headers;
+
+  @override
+  Widget build(BuildContext context) {
+    if (headers.isEmpty) {
+      return const _EmptyHint(text: 'No headers recorded.');
+    }
+    return Column(
