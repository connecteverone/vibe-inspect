+      final apiContext = ApiEventContext.fromPayload(event.payload);
+      if (apiContext == null) {
+        _openContextError(
+          title: 'Context unavailable',
+          message:
+              'This API event is missing request or response details needed to restore the explorer.',
+          event: event,
+        );
+        return;
