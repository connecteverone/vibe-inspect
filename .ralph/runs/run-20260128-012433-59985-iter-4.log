+        return;
+      }
+      _pushContextScreen(
+        TerminalSessionScreen(
+          event: event,
+          session: session,
+        ),
+      );
+      return;
+    }
+
+    _openContextError(
+      title: 'Context unavailable',
+      message: 'This event type does not yet support context restore.',
+      event: event,
+    );
+  }
