+  final String? body;
+
+  factory ApiResponseDetails.fromPayload(Map<String, dynamic> payload) {
+    final statusValue =
+        payload['status'] ?? payload['status_code'] ?? payload['statusCode'];
+    final latencyValue =
+        payload['latency_ms'] ?? payload['latencyMs'] ?? payload['latency'];
+    return ApiResponseDetails(
