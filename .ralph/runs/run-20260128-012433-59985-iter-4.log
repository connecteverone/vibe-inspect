+      return;
+    }
+
+    _openContextError(
+      title: 'Context unavailable',
+      message: 'This event type does not yet support context restore.',
+      event: event,
+    );
+  }
+
+  ToolSession? _findSessionById(
+    List<ToolSession> sessions,
