+  Future<void> _handleTimelineEventTap(TimelineEvent event) async {
+    final eventType = event.type.toLowerCase();
+    if (eventType == 'api') {
+      final apiContext = ApiEventContext.fromPayload(event.payload);
+      if (apiContext == null) {
+        _openContextError(
+          title: 'Context unavailable',
+          message:
