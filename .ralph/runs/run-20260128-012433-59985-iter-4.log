+        statusValue?.toString() ?? '',
+      ),
+      latencyMs: latencyValue is num ? latencyValue.toInt() : int.tryParse(
+        latencyValue?.toString() ?? '',
+      ),
+      headers: _parseHeaders(payload['headers']),
+      body: _stringifyBody(payload['body'] ?? payload['data']),
+    );
+  }
