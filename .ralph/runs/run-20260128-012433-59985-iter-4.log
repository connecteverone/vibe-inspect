+      if (session == null) {
+        try {
+          final sessions = await widget.storage.fetchToolSessions();
+          session = _findSessionById(sessions, event.sessionId);
+        } catch (_) {
+          session = null;
+        }
+      }
+      if (!mounted) {
+        return;
+      }
+      if (session == null) {
+        _openContextError(
+          title: 'Session missing',
+          message:
+              'The referenced terminal session could not be found in local history.',
+          event: event,
+        );
+        return;
