+      crossAxisAlignment: CrossAxisAlignment.start,
+      children: headers.entries
+          .map(
+            (entry) => _KeyValueRow(
+              label: entry.key,
+              value: entry.value,
+            ),
+          )
+          .toList(),
+    );
+  }
+}
