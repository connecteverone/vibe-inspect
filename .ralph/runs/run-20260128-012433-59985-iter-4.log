+                    value: event.type.toUpperCase(),
+                  ),
+                  _KeyValueRow(label: 'Title', value: event.title),
+                  _KeyValueRow(
+                    label: 'Timestamp',
+                    value: _formatTimestamp(event.createdAt),
+                  ),
+                ],
+              ),
