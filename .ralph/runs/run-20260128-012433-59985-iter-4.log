+          session = _findSessionById(sessions, event.sessionId);
+        } catch (_) {
+          session = null;
+        }
+      }
+      if (!mounted) {
+        return;
+      }
+      if (session == null) {
+        _openContextError(
+          title: 'Session missing',
+          message:
+              'The referenced terminal session could not be found in local history.',
+          event: event,
+        );
+        return;
+      }
+      _pushContextScreen(
+        TerminalSessionScreen(
+          event: event,
+          session: session,
+        ),
+      );
+      return;
+    }
