+    if (eventType == 'terminal') {
+      var session = _findSessionById(_toolSessions, event.sessionId);
+      if (session == null) {
+        try {
+          final sessions = await widget.storage.fetchToolSessions();
+          session = _findSessionById(sessions, event.sessionId);
+        } catch (_) {
+          session = null;
+        }
+      }
+      if (!mounted) {
+        return;
