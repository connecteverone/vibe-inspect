+  Future<void> _applyClosedReasons(
+    Map<String, String> closedReasons,
+    Map<String, TimelineEvent> latestEvents,
+    List<ToolSession> terminalSessions,
+  ) async {
+    for (final entry in closedReasons.entries) {
