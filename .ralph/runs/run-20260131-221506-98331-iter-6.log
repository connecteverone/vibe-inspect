+        type: 'terminal',
+        title: 'Terminal: ${session.label}',
+        payload: {
+          'command': '',
+          'status': 'closed',
+          'next_seq': 0,
+          'error_message': reason,
+        },
+        createdAt: DateTime.now(),
+      );
+      try {
+        await widget.storage.insertTimelineEvent(event);
+        latestEvents[sessionId] = event;
+      } catch (_) {
+        // Ignore storage errors for recovery hint.
+      }
+    }
