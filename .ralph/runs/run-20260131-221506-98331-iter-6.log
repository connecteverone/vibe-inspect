+        final command = existing.payload['command']?.toString() ?? '';
+        final updated = await _persistTerminalEvent(
+          event: existing,
+          command: command,
+          entries: entries,
+          status: 'closed',
+          nextSeq: _parseNextSeq(existing.payload),
+          exitCode: null,
+          errorMessage: reason,
+        );
