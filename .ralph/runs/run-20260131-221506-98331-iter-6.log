+          event: existing,
+          command: command,
+          entries: entries,
+          status: 'closed',
+          nextSeq: _parseNextSeq(existing.payload),
+          exitCode: null,
+          errorMessage: reason,
+        );
+        if (updated != null) {
+          latestEvents[sessionId] = updated;
+        }
+        continue;
+      }
+      final session = terminalSessions.firstWhere(
+        (session) => session.id == sessionId,
+        orElse: () => ToolSession(
