+fn build_session_summary(session: &TerminalSession) -> TerminalSessionSummary {
+    let last_output = session
+        .buffer
+        .back()
+        .map(|chunk| chunk.data.trim().to_string())
+        .unwrap_or_default();
+    let preview = if last_output.chars().count() > 160 {
