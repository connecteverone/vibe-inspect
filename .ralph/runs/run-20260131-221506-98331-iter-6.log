+            .chars()
+            .rev()
+            .take(160)
+            .collect::<Vec<char>>()
+            .into_iter()
+            .rev()
+            .collect()
+    } else {
+        last_output
+    };
+    TerminalSessionSummary {
+        id: session.id.clone(),
+        label: session.label.clone(),
+        status: session.status.as_str().to_string(),
+        created_at: session.created_at,
+        last_activity: session.last_activity,
