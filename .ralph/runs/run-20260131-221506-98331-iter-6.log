+    if let Some(parent) = path.parent() {
+        fs::create_dir_all(parent)?;
+    }
+    let mut entries = sessions.values().cloned().collect::<Vec<_>>();
+    entries.sort_by(|a, b| b.last_activity.cmp(&a.last_activity));
