+        self.active_connections.fetch_add(1, Ordering::Relaxed);
+    }
+
+    fn decrement_connections(&self) {
+        let _ = self.active_connections.fetch_update(
+            Ordering::Relaxed,
+            Ordering::Relaxed,
+            |value| Some(value.saturating_sub(1)),
+        );
