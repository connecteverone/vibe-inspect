+            return;
+        }
+    };
+
+    let request_id = parsed.get("id").and_then(|value| value.as_str()).unwrap_or("");
+    let message_type = parsed
+        .get("type")
+        .and_then(|value| value.as_str())
+        .unwrap_or("");
+    let action = parsed
+        .get("action")
+        .and_then(|value| value.as_str())
+        .unwrap_or("");
+    if message_type != "req" || action != "auth" {
+        send_error_and_close(
