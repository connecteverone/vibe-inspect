+            "message": message,
+        }
+    });
+    let _ = send_json(socket, payload).await;
+    let _ = socket.send(Message::Close(None)).await;
+}
+
+fn parse_major_version(version: &str) -> Option<u64> {
+    version.split('.').next()?.parse().ok()
