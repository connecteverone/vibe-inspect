+
+  void _setPointerPosition(Offset position) {
+    final clamped = Offset(
+      position.dx.clamp(0, _canvasSize.width),
+      position.dy.clamp(0, _canvasSize.height),
+    );
+    setState(() {
+      _pointerPosition = clamped;
