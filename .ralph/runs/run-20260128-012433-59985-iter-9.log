+  void _updateZoom(double value) {
+    setState(() {
+      _zoom = value.clamp(_minZoom, _maxZoom);
+      _cameraCenter = _pointerPosition;
+    });
+  }
+
+  void _commitZoom(double value) {
+    _updateZoom(value);
+    unawaited(_updateSession(status: _currentStatusLabel));
