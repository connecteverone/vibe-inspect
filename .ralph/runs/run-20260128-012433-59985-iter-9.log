+  Future<void> sendVncCommand({
+    required String action,
+    String? sessionId,
+    int? width,
+    int? height,
+  }) async {
+    final payload = <String, dynamic>{
+      'action': action,
+    };
+    if (sessionId != null && sessionId.trim().isNotEmpty) {
+      payload['session_id'] = sessionId;
+    }
+    if (width != null) {
+      payload['width'] = width;
