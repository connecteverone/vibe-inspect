+  @override
+  void initState() {
+    super.initState();
+    _pointerPosition = Offset(
+      _canvasSize.width / 2,
+      _canvasSize.height / 2,
+    );
+    _cameraCenter = _pointerPosition;
+    _lastUpdatedAt = widget.event.createdAt;
+    _configureAgentClient();
+    _hydrateFromPayload();
+    unawaited(_startStream());
