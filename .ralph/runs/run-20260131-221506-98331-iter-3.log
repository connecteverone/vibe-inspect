await waitForPageLoad(page);

await page.evaluate(() => {
  const list = document.getElementById(\"pairedDevices\");
  if (list && typeof window.renderDeviceList === \"function\") {
    window.renderDeviceList(
      list,
      [
        {
          id: \"8f3a1b\",
          name: \"iOS\",
          last_seen_at: Math.floor(Date.now() / 1000),
          paired_at: Math.floor(Date.now() / 1000) - 3600,
        },
      ],
      \"No paired devices.\",
      { showActions: true, pairedTag: true }
    );
  }
});

const titleText = await page.textContent(\"#pairedDevices .device-title\");
const metaText = await page.textContent(\"#pairedDevices .device-meta\");
await page.screenshot({ path: \"tmp/device-list.png\", fullPage: true });

console.log({ titleText, metaText });
await client.disconnect();
