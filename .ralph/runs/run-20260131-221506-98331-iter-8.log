+      return;
+    }
+    _lastNotificationToastAt = now;
+    final message = latestEvent.payload['message']?.toString() ?? '';
+    if (message.trim().isEmpty) {
+      return;
+    }
+    ScaffoldMessenger.of(context).showSnackBar(
