+      final rawId = item['id']?.toString() ?? '';
+      final notificationId =
+          rawId.trim().isNotEmpty ? rawId.trim() : createStorageId();
+      final level = item['level']?.toString().toLowerCase() ?? 'info';
+      final createdAt =
