+                    continue;
+                }
+            }
+            self.notification_cache.insert(fingerprint, now);
+            if self.notification_cache.len() > NOTIFICATION_QUEUE_LIMIT {
+                self.notification_cache
+                    .retain(|_, ts| now.saturating_sub(*ts) < 300);
+            }
