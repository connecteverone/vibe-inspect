+            let trimmed = line.trim();
+            if trimmed.is_empty() {
+                continue;
+            }
+            let lowered = trimmed.to_lowercase();
+            let (level, matched) = if lowered.contains("warning") || lowered.contains("warn") {
+                ("warning", true)
+            } else if lowered.contains("error")
+                || lowered.contains("failed")
+                || lowered.contains("fatal")
+            {
+                ("error", true)
+            } else {
+                ("info", false)
+            };
