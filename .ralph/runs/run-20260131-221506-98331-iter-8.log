+                level: level.to_string(),
+                created_at: now,
+                source: "terminal_output".to_string(),
+                seq: self.notification_seq,
+            };
+            if self.notifications.len() >= NOTIFICATION_QUEUE_LIMIT {
+                self.notifications.pop_front();
+            }
+            self.notifications.push_back(notification);
+        }
