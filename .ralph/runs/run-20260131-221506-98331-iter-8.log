+    if message.chars().count() <= max_len {
+        return message.to_string();
+    }
+    if max_len <= 3 {
+        return message.chars().take(max_len).collect();
+    }
+    let mut truncated = message.chars().take(max_len - 3).collect::<String>();
+    truncated.push_str("...");
+    truncated
