+    final parsed = <Map<String, dynamic>>[];
+    for (final item in rawNotifications) {
+      if (item is! Map) {
+        continue;
+      }
+      parsed.add(Map<String, dynamic>.from(item));
+    }
+    if (parsed.isEmpty) {
+      return;
+    }
