+async fn flush_outbound_queue(
+    sender: &mut WsSender,
+    queue: &mut OutboundQueue,
+    last_sent_at: &mut Instant,
+) -> Result<(), axum::Error> {
+    while let Some(message) = queue.pop() {
+        sender.send(Message::Text(message.text.into())).await?;
