+                removed_bytes = removed_bytes.saturating_add(message.bytes);
+                continue;
+            }
+            retained.push_back(message);
+        }
+        self.items = retained;
+        self.bytes = self.bytes.saturating_sub(removed_bytes);
+        removed_bytes
+    }
