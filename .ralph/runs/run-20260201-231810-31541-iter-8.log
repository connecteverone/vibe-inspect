+    if !still_pending.is_empty() {
+        for session_id in still_pending {
+            backpressure.pending_snapshots.insert(session_id);
+        }
+        return false;
+    }
+    backpressure.paused = false;
+    let resumed_event = build_stream_event("stream_resumed", json!({}));
