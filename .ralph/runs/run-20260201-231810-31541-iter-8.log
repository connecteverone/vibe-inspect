+    let text = value.to_string();
+    let bytes = text.as_bytes().len();
+    if queue.bytes.saturating_add(bytes) > MAX_SEND_QUEUE_BYTES {
+        return EnqueueResult::Dropped;
+    }
+    queue.push(QueuedMessage {
+        text,
+        bytes,
+        is_terminal_payload,
+        session_id,
+    });
+    EnqueueResult::Enqueued
+}
