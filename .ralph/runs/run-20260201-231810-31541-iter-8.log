+        backpressure.pending_snapshots.insert(session_id.to_string());
+        queue.remove_terminal_payloads(Some(session_id));
+    }
+    if backpressure.paused {
+        return EnqueueResult::Dropped;
+    }
+    backpressure.paused = true;
