+    if !backpressure.paused {
+        return false;
+    }
+    let session_ids = backpressure
+        .pending_snapshots
+        .drain()
+        .collect::<Vec<_>>();
+    let mut still_pending = Vec::new();
+    for session_id in session_ids {
+        let notify_since = subscriptions
