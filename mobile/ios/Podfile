# Uncomment this line to define a global platform for your project
# platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end

  # CocoaPods adds Pods_Runner.framework to Runner's link phase when use_frameworks! is on.
  # With Flutter's custom CONFIGURATION_BUILD_DIR, that framework ends up outside the search paths.
  # Remove it so we only link the actual pod frameworks specified by Pods-Runner xcconfigs.
  # Flutter sets a custom CONFIGURATION_BUILD_DIR. When use_frameworks! is on,
  # CocoaPods' embed script looks in BUILT_PRODUCTS_DIR, which then points to
  # Flutter's build dir instead of the Pods build dir. Patch the script to look
  # in PODS_CONFIGURATION_BUILD_DIR to avoid "source: unbound variable".
  script_path = installer.sandbox.root + 'Target Support Files/Pods-Runner/Pods-Runner-frameworks.sh'
  if File.exist?(script_path)
    script = File.read(script_path)
    unless script.include?('PODS_CONFIGURATION_BUILD_DIR')
      insert = <<~'SH'
        if [ -n "${PODS_CONFIGURATION_BUILD_DIR-}" ]; then
          BUILT_PRODUCTS_DIR="${PODS_CONFIGURATION_BUILD_DIR}"
        fi

      SH
      script.sub!("set -o pipefail\n\n", "set -o pipefail\n\n#{insert}")
      File.write(script_path, script)
    end
  end
end
